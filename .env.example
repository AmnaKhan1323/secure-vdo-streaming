# No values in this template are live credentials. Copy to .env for standard setup.
# PostgreSQL: provide your own connection URL. Docker Compose uses the separate
# POSTGRES_PASSWORD below; do not use an unescaped password in a URL.
DATABASE_URL=
POSTGRES_PASSWORD=

# Generate at least 32 random bytes privately. Do not send secrets through chat.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Gumlet workspace API key (Bearer), workspace ID, and signing secret.
# GUMLET_SIGNING_SECRET is Base64 per the official JavaScript iframe example.
GUMLET_API_KEY=
GUMLET_WORKSPACE_ID=
GUMLET_SIGNING_SECRET=
# Default matches the official signing example. If your account returns hex,
# confirm with Gumlet and choose hex explicitly; there is no encoding guessing.
GUMLET_SIGNING_SECRET_ENCODING=base64
# Optional different representation returned by the workspace API (base64 / hex).
GUMLET_REMOTE_SECRET_ENCODING=base64

# Bunny: Stream API key and the separate embed/CDN token authentication key.
# CORE_API_KEY is for remote library / linked Pull Zone protection checks.
BUNNY_STREAM_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_AUTH_KEY=
BUNNY_CORE_API_KEY=
# Current player by default. Legacy host is opt-in and requires PlayerVersion=1.
BUNNY_PLAYER_HOST=player.mediadelivery.net

# Direct HTTPS media source hosts approved for admin URL imports; comma-separated.
# Empty means imports are disabled. Never put origin credentials in a source URL.
VIDEO_IMPORT_ALLOWED_HOSTS=

# Optional real assets used ONLY by credential-gated live tests. Seed has no IDs.
LIVE_GUMLET_ASSET_ID=
LIVE_BUNNY_VIDEO_ID=
# Opt in to read-only provider embed HTTP probes. Browser tests are still needed.
LIVE_EMBED_PROBES=false