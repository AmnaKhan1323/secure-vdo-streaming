{
  "name": "secure-vdo-streaming",
  "version": "0.1.0",
  "private": true,
  "description": "Small Next.js prototype comparing secure Gumlet and Bunny Stream course-video playback.",
  "repository": { "type": "git", "url": "https://github.com/amnakhan1323/secure-vdo-streaming.git" },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "tsx scripts/local-dev.ts",
    "build": "prisma generate --config prisma.config.ts && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate --config prisma.config.ts && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx --test tests/live/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "dependencies": {
    "@gumlet/player.js": "^3.0.11",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.27",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "player.js": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
